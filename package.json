{
  "name": "@ashbhati/draw",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "bin": {
    "draw": "bin/draw.js"
  },
  "files": [
    "bin/",
    "src/runtime/",
    "src/integrations/",
    "src/document/",
    "src/export/",
    "src/ui/storage.ts",
    "src/ui/autosave.ts",
    "dist/",
    "README.md",
    "PLAN.md",
    "docs/PACKAGING.md",
    "docs/ASSET_ATTRIBUTION.md",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-production-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src tests/e2e/config.test.ts",
    "test:watch": "vitest",
    "mcp": "tsx src/integrations/mcp-server.ts",
    "test:e2e:production": "npm run build && playwright test --config playwright.production.config.ts",
    "test:e2e:package": "playwright test --config playwright.package.config.ts",
    "test:package:installed": "node scripts/test-packaged-runtime.mjs",
    "prepack": "npm run build",
    "test:e2e": "playwright test",
    "test:release": "npm test && npm run build && npm run test:e2e && npm run test:e2e:production && npm run test:package:installed"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
